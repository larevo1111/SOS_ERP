<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. API - Redirigir /api/* al enrutador PHP
    RewriteRule ^api/(.*)$ erp/infraestructura/rutas.php [QSA,L]

    # 2. Archivos estaticos
    # Si el archivo solicitado existe en la ruta del SPA, servirlo directamente
    RewriteCond %{DOCUMENT_ROOT}/erp/frontend/dist/spa%{REQUEST_URI} -f
    RewriteRule ^(.*)$ erp/frontend/dist/spa/$1 [L]

    # 3. Fallback para Rutas de Vue (SPA)
    # Permite navegar a /productos y que cargue el index.html
    RewriteCond %{REQUEST_URI} !^/api/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ erp/frontend/dist/spa/index.html [L]

    # 4. Raiz vacia
    RewriteRule ^$ erp/frontend/dist/spa/index.html [L]
</IfModule>
