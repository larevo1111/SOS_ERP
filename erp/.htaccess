<IfModule mod_rewrite.c>
    RewriteEngine On

    # Si se accede desde http://localhost/erp/ en Windows/Ubuntu, necesitamos esta base:
    # Si se accede desde https://erp.oscomunidad.com directo (Hostinger), la ignorará si no se usa.
    RewriteBase /

    # 1. API - Enviar tráfico de /api/ al framework backend
    RewriteCond %{REQUEST_URI} api/ [NC]
    RewriteRule ^(.*)?api/(.*)$ erp/infraestructura/rutas.php [QSA,L]

    # 2. Ignorar tráfico que ya está en la carpeta compilada (prevención de bucles)
    RewriteCond %{REQUEST_URI} /frontend/dist/spa/ [NC]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ erp/frontend/dist/spa/index.html [L]

    # 3. Frontend Estático - Servir los archivos compilados en Producción
    # Si no es tráfico de API ni archivos ya en dist/spa...
    RewriteCond %{REQUEST_URI} !api/ [NC]
    RewriteCond %{REQUEST_URI} !/frontend/dist/spa/ [NC]
    RewriteRule ^(?:erp/)?(.*)$ erp/frontend/dist/spa/$1 [L]
</IfModule>
