# erp/frontend/.env.example
#
# Copia este archivo como .env y rellena los valores reales.
# El archivo .env está en .gitignore — NUNCA lo subas al repo.
#
# Cómo obtener los valores:
#   VITE_API_URL   → La URL donde corre el backend PHP.
#                    Local:      http://localhost/erp/api
#                    Producción: https://erp.oscomunidad.com/api
#
#   VITE_API_TOKEN → El mismo valor que R2_TOKEN en el .env del servidor (erp/.env).
#                    Es el secreto compartido que protege la API.

VITE_API_URL=http://localhost/erp/api
VITE_API_TOKEN=pon_aqui_tu_token_secreto
